{
  "enabled": true,
  "debug": false,
  "protectedPatterns": [
    "(^|[\\\\/])my-secret-store\\.json$",
    "(^|[\\\\/])company-credentials\\.json$"
  ],
  "readRedaction": {
    "enabled": false,
    "includeShellOutput": false,
    "scope": "protectedOnly"
  },
  "contentScanning": {
    "enabled": true,
    "blockSeverity": "high",
    "maxFindings": 20,
    "customPatterns": [
      {
        "_comment": "Add your own secret patterns here. Pattern is a regex string.",
        "name": "My Internal API Key",
        "pattern": "myapi_[A-Za-z0-9]{32}",
        "severity": "high"
      }
    ]
  },
  "blockedEvents": {
    "emit": true,
    "log": true,
    "logPath": "logs/blocked-events.jsonl"
  },
  "protectedFileEdits": {
    "enabled": false
  }
}
