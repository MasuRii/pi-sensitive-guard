{
  "enabled": true,
  "debug": false,
  "protectedPatterns": [
    "(^|[\\\\/])my-secret-store\\.json$",
    "(^|[\\\\/])company-credentials\\.json$"
  ],
  "readRedaction": {
    "enabled": false,
    "includeShellOutput": false,
    "scope": "protectedOnly"
  },
  "blockedEvents": {
    "emit": true,
    "log": true,
    "logPath": "logs/blocked-events.jsonl"
  },
  "protectedFileEdits": {
    "enabled": false
  }
}
